---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ByteBucket — Lightning-fast Image CDN & Edge Storage",
  description = "Ultra-fast global image CDN and developer-first storage. Resize, compress, and deliver every image with Apple-grade simplicity.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Preload Apple-like typography fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Apple-style subtle ambient glow spotlight -->
    <div class="apple-spotlight"></div>
    <div class="apple-grid-overlay"></div>

    <div class="app-container">
      <slot />
    </div>

    <!-- Global Toast Feedback Container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000000;
    --bg-secondary: #0a0a0c;
    --surface: rgba(255, 255, 255, 0.04);
    --surface-hover: rgba(255, 255, 255, 0.07);
    --surface-active: rgba(255, 255, 255, 0.1);
    --surface-solid: #121215;
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.16);
    --border-bright: rgba(255, 255, 255, 0.28);

    --text-primary: #f5f5f7;
    --text-secondary: #86868b;
    --text-tertiary: #6e6e73;

    --apple-blue: #2997ff;
    --apple-blue-glow: rgba(41, 151, 255, 0.25);
    --apple-purple: #bf5af2;
    --apple-green: #30d158;
    --apple-red: #ff453a;
    --apple-red-surface: rgba(255, 69, 58, 0.12);
    --apple-red-border: rgba(255, 69, 58, 0.28);

    --font-sans:
      -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
      "Plus Jakarta Sans", -apple-system, sans-serif;
    --font-mono:
      "JetBrains Mono", SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    background: #000000;
    overflow-x: hidden;
    position: relative;
    line-height: 1.5;
  }

  /* Apple Ambient Spotlight & Grid Effect */
  .apple-spotlight {
    position: fixed;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    height: 600px;
    background: radial-gradient(
      circle at 50% 30%,
      rgba(120, 119, 198, 0.14) 0%,
      rgba(41, 151, 255, 0.06) 45%,
      transparent 70%
    );
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .apple-grid-overlay {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(
      ellipse 65% 50% at 50% 0%,
      #000 60%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .app-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Container Shell & Global Responsiveness */
  .shell {
    width: min(1200px, calc(100% - 48px));
    margin-left: auto;
    margin-right: auto;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .shell {
      width: calc(100% - 28px);
    }
  }

  @media (max-width: 480px) {
    .shell {
      width: calc(100% - 20px);
    }
  }

  img, video, svg {
    max-width: 100%;
    height: auto;
  }

  pre, code {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-scroll-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Apple-style Typography & Headings */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  /* Apple Gradient Text */
  .gradient-text {
    background: linear-gradient(180deg, #ffffff 15%, #a1a1a6 85%, #6e6e73 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text-blue {
    background: linear-gradient(135deg, #ffffff 20%, #70b4ff 70%, #bf5af2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text-silver {
    background: linear-gradient(180deg, #ffffff 0%, #d1d1d6 50%, #8e8e93 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Eyebrow / Subhead */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  /* Frosted Glass Utilities */
  .glass {
    background: var(--surface);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .glass:hover {
    border-color: var(--border-hover);
  }

  .glass-card {
    background: rgba(18, 18, 22, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(24, 24, 30, 0.75);
  }

  /* Apple Pill Badge */
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    color: #e5e5ea;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Status Indicators */
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--apple-green);
    box-shadow: 0 0 10px var(--apple-green);
    display: inline-block;
  }

  /* Focus styling */
  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--apple-blue);
    outline-offset: 3px;
  }

  /* Apple-style Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Toast Notification */
  .toast-container {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
  }

  .toast {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(20, 20, 24, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    padding: 12px 18px;
    border-radius: 9999px;
    box-shadow:
      0 15px 35px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
  }

  .toast.toast-exit {
    animation: toastOut 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .toast-icon {
    display: grid;
    place-items: center;
    color: var(--apple-green);
  }

  @keyframes toastIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes toastOut {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(12px) scale(0.95);
    }
  }
</style>

<script>
  // Global Toast Notification Helper
  declare global {
    interface Window {
      showToast: (message: string, duration?: number) => void;
    }
  }

  window.showToast = (message: string, duration: number = 2200) => {
    const container = document.getElementById("toast-container");
    if (!container) return;

    const toast = document.createElement("div");
    toast.className = "toast";
    toast.innerHTML = `
      <span class="toast-icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>
      <span>${message}</span>
    `;

    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.add("toast-exit");
      setTimeout(() => toast.remove(), 260);
    }, duration);
  };
</script>
