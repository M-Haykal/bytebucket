---
import { BookOpen, Copy, Check, Terminal, Code2, Globe, Sliders, ExternalLink, ShieldCheck, CheckCircle2, FileCode, Cpu, Layers } from "lucide-astro";
---

<section id="cdn-docs" class="cdn-guide-section glass">
  <div class="guide-header">
    <div class="header-text">
      <div class="header-eyebrow">
        <BookOpen size={14} class="eyebrow-icon" />
        <span>CDN & INTEGRATION REFERENCE</span>
      </div>
      <h2>CDN & Edge API Guide</h2>
      <p class="section-desc">
        Integrate ByteBucket dynamic image delivery and on-the-fly transformations directly into your applications in seconds using <code>https://bytebucket.hayproject.my.id</code>.
      </p>
    </div>

    <a href="/docs" class="btn-full-docs">
      <span>Read Full API Docs</span>
      <ExternalLink size={13} stroke-width={2} />
    </a>
  </div>

  <!-- Quickstart Cards Grid -->
  <div class="guide-grid">
    <!-- 1. URL Structure & Transformations -->
    <div class="guide-card">
      <div class="card-top">
        <div class="card-icon">
          <Globe size={18} />
        </div>
        <div>
          <h4>1. Dynamic Delivery URL</h4>
          <span class="card-subtitle">Zero pipelines, infinite variations</span>
        </div>
      </div>

      <p class="card-expl">
        Every uploaded image is immediately routed to our global edge. Append URL query parameters to dynamically resize, crop, and reformat images in real-time:
      </p>

      <div class="url-example-box">
        <span class="url-protocol">GET</span>
        <code class="url-text">https://bytebucket.hayproject.my.id/cdn/<span class="hl-file">hero.jpg</span>?<span class="hl-param">w=800</span>&<span class="hl-param">format=webp</span>&<span class="hl-param">q=85</span></code>
        <button class="btn-copy-code" data-copy="https://bytebucket.hayproject.my.id/cdn/hero.jpg?w=800&format=webp&q=85" title="Copy URL">
          <Copy size={13} class="copy-icon" />
          <Check size={13} class="check-icon hidden" />
        </button>
      </div>

      <!-- Parameters mini table -->
      <div class="params-table-mini">
        <div class="param-row">
          <code>w=800</code>
          <span>Target width in pixels (maintains aspect ratio)</span>
        </div>
        <div class="param-row">
          <code>h=600</code>
          <span>Target height in pixels (optional)</span>
        </div>
        <div class="param-row">
          <code>format=webp</code>
          <span>Convert on-the-fly to <code>webp</code>, <code>avif</code>, <code>png</code></span>
        </div>
        <div class="param-row">
          <code>q=85</code>
          <span>Sharp compression quality level (1 - 100)</span>
        </div>
        <div class="param-row">
          <code>fit=cover</code>
          <span>Crop strategy: <code>cover</code>, <code>contain</code>, <code>inside</code></span>
        </div>
      </div>
    </div>

    <!-- 2. Authentication & Upload Rules -->
    <div class="guide-card">
      <div class="card-top">
        <div class="card-icon">
          <Terminal size={18} />
        </div>
        <div>
          <h4>2. Upload Authentication</h4>
          <span class="card-subtitle">Secure server-to-server API</span>
        </div>
      </div>

      <p class="card-expl">
        Send a multipart POST request with your secret API key in the request header. Never expose secret keys in public client-side browser bundles:
      </p>

      <div class="code-box">
        <div class="code-box-header">
          <span>HTTP Headers for Upload</span>
        </div>
        <pre class="code-pre"><code><span class="code-header">POST</span> /api/v1/upload HTTP/1.1
<span class="code-header">Host:</span> bytebucket.hayproject.my.id
<span class="code-header">X-API-Key:</span> sk_live_your_secret_token_here
<span class="code-header">Content-Type:</span> multipart/form-data</code></pre>
      </div>

      <div class="specs-pill-row">
        <span class="spec-pill">Field: <code>images</code></span>
        <span class="spec-pill">Max: 10 files / request</span>
        <span class="spec-pill">Size: &le; 25 MB / file</span>
        <span class="spec-pill">JPG, PNG, WebP, AVIF</span>
      </div>

      <div class="callout-tip">
        <strong>Edge Cache Header:</strong> Deliveries are automatically cached with <code>Cache-Control: public, max-age=31536000, immutable</code>.
      </div>
    </div>
  </div>

  <!-- REST Endpoints Quick Reference Table -->
  <div class="endpoints-summary">
    <div class="summary-header">
      <Cpu size={15} class="text-blue" />
      <strong>Available API Endpoints</strong>
    </div>
    <div class="table-scroll-wrap">
      <table class="endpoints-table">
        <thead>
          <tr>
            <th>Method</th>
            <th>Endpoint</th>
            <th>Headers / Auth</th>
            <th>Purpose</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="badge-method post">POST</span></td>
            <td><code>https://bytebucket.hayproject.my.id/api/v1/upload</code></td>
            <td><code>X-API-Key: sk_live_...</code></td>
            <td>Upload multipart images (up to 10 files, 25MB)</td>
          </tr>
          <tr>
            <td><span class="badge-method get">GET</span></td>
            <td><code>https://bytebucket.hayproject.my.id/cdn/:filename</code></td>
            <td>None (Public Edge)</td>
            <td>Serve and dynamically transform images</td>
          </tr>
          <tr>
            <td><span class="badge-method get">GET</span></td>
            <td><code>https://bytebucket.hayproject.my.id/api/images</code></td>
            <td><code>Authorization: Bearer &lt;JWT&gt;</code></td>
            <td>List all stored assets metadata for user account</td>
          </tr>
          <tr>
            <td><span class="badge-method post">POST</span></td>
            <td><code>https://bytebucket.hayproject.my.id/api/keys/generate</code></td>
            <td><code>Authorization: Bearer &lt;JWT&gt;</code></td>
            <td>Generate a new secret API key</td>
          </tr>
          <tr>
            <td><span class="badge-method delete">DELETE</span></td>
            <td><code>https://bytebucket.hayproject.my.id/api/keys/:id</code></td>
            <td><code>Authorization: Bearer &lt;JWT&gt;</code></td>
            <td>Revoke an existing API key immediately</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Interactive Code Snippets Showcase -->
  <div class="snippet-showcase">
    <div class="snippet-tabs-bar">
      <div class="tabs-scroll-container">
        <button class="tab-btn active" data-tab="curl">cURL</button>
        <button class="tab-btn" data-tab="js">JavaScript (Node / Fetch)</button>
        <button class="tab-btn" data-tab="python">Python</button>
        <button class="tab-btn" data-tab="php">PHP / Laravel</button>
        <button class="tab-btn" data-tab="html">HTML &lt;picture&gt;</button>
      </div>

      <button id="copy-active-snippet" class="btn-copy-snippet">
        <Copy size={13} class="copy-icon" />
        <Check size={13} class="check-icon hidden" />
        <span class="copy-text">Copy Code</span>
      </button>
    </div>

    <!-- Tab 1: cURL -->
    <div id="tab-curl" class="tab-content active">
      <pre><code><span class="c-comment"># 1. Upload an image to ByteBucket</span>
curl -X POST https://bytebucket.hayproject.my.id/api/v1/upload \
  -H "X-API-Key: sk_live_your_secret_key" \
  -F "images=@./banner.png"

<span class="c-comment"># 2. Fetch the transformed image directly from the Edge CDN</span>
curl "https://bytebucket.hayproject.my.id/cdn/banner.webp?w=1200&format=webp&q=85" \
  -o banner-optimized.webp</code></pre>
    </div>

    <!-- Tab 2: JavaScript -->
    <div id="tab-js" class="tab-content">
      <pre><code><span class="c-comment">// Node.js (v18+) or Browser Multipart Upload</span>
const formData = new FormData();
formData.append('images', fileBlob, 'photo.jpg');

const uploadResponse = await fetch('https://bytebucket.hayproject.my.id/api/v1/upload', &#123;
  method: 'POST',
  headers: &#123;
    'X-API-Key': process.env.BYTEBUCKET_API_KEY
  &#125;,
  body: formData
&#125;);

const result = await uploadResponse.json();
console.log('Original CDN URL:', result.data.cdn_url);

<span class="c-comment">// Serve with dynamic on-the-fly resizing</span>
const cdnUrl = result.data.cdn_url + '?w=800&format=webp&q=85';</code></pre>
    </div>

    <!-- Tab 3: Python -->
    <div id="tab-python" class="tab-content">
      <pre><code><span class="c-comment"># Python Requests Example</span>
import requests

API_KEY = "sk_live_your_secret_key"
url = "https://bytebucket.hayproject.my.id/api/v1/upload"

with open("banner.png", "rb") as f:
    response = requests.post(
        url,
        headers=&#123;"X-API-Key": API_KEY&#125;,
        files=&#123;"images": f&#125;
    )

data = response.json()
print("Uploaded CDN URL:", data["data"]["cdn_url"])</code></pre>
    </div>

    <!-- Tab 4: PHP -->
    <div id="tab-php" class="tab-content">
      <pre><code><span class="c-comment">// Laravel Http Client Example</span>
use Illuminate\Support\Facades\Http;

$response = Http::withHeaders([
    'X-API-Key' => env('BYTEBUCKET_API_KEY')
])->attach(
    'images', file_get_contents($path), 'asset.png'
)->post('https://bytebucket.hayproject.my.id/api/v1/upload');

$cdnUrl = $response->json('data.cdn_url');</code></pre>
    </div>

    <!-- Tab 5: HTML -->
    <div id="tab-html" class="tab-content">
      <pre><code><span class="c-comment">&lt;!-- Responsive Image with ByteBucket Edge CDN --&gt;</span>
&lt;picture&gt;
  &lt;source 
    srcset="https://bytebucket.hayproject.my.id/cdn/hero.webp?w=1200&format=avif 1200w, https://bytebucket.hayproject.my.id/cdn/hero.webp?w=600&format=avif 600w" 
    type="image/avif" /&gt;
  &lt;source 
    srcset="https://bytebucket.hayproject.my.id/cdn/hero.webp?w=1200&format=webp 1200w, https://bytebucket.hayproject.my.id/cdn/hero.webp?w=600&format=webp 600w" 
    type="image/webp" /&gt;
  &lt;img 
    src="https://bytebucket.hayproject.my.id/cdn/hero.webp?w=800" 
    alt="Hero Asset" 
    loading="lazy" 
    decoding="async" /&gt;
&lt;/picture&gt;</code></pre>
    </div>
  </div>
</section>

<style>
  .cdn-guide-section {
    padding: 34px;
    margin-bottom: 24px;
  }

  .guide-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 28px;
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  .header-text h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .section-desc {
    color: #86868b;
    font-size: 14px;
    max-width: 650px;
    line-height: 1.5;
  }

  .section-desc code {
    color: #60a5fa;
    background: rgba(41, 151, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .btn-full-docs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f5f5f7;
    font-size: 12.5px;
    font-weight: 500;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-full-docs:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Guide Grid */
  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }

  .guide-card {
    padding: 24px;
    border-radius: 20px;
    background: rgba(14, 14, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(41, 151, 255, 0.12);
    border: 1px solid rgba(41, 151, 255, 0.25);
    color: var(--apple-blue);
  }

  .card-top h4 {
    font-size: 16px;
    font-weight: 650;
    color: #ffffff;
  }

  .card-subtitle {
    font-size: 11.5px;
    color: #86868b;
  }

  .card-expl {
    font-size: 13px;
    color: #a1a1a6;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .url-example-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #09090c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 14px;
    overflow-x: auto;
  }

  .url-protocol {
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(48, 209, 88, 0.18);
    color: #30d158;
    letter-spacing: 0.05em;
  }

  .url-text {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #e5e5ea;
    white-space: nowrap;
    flex: 1;
  }

  .hl-file { color: #93c5fd; }
  .hl-param { color: #fca5a5; }

  .btn-copy-code {
    background: transparent;
    border: none;
    color: #86868b;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 4px;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-copy-code:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .params-table-mini {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 12px;
  }

  .param-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }

  .param-row code {
    font-family: var(--font-mono);
    color: #60a5fa;
    background: rgba(41, 151, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    min-width: 95px;
  }

  .param-row span {
    color: #86868b;
  }

  .code-box {
    border-radius: 12px;
    background: #09090c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    margin-bottom: 12px;
  }

  .code-box-header {
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 10.5px;
    color: #707078;
    font-weight: 600;
  }

  .code-pre {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #d1d1d6;
    line-height: 1.6;
    margin: 0;
  }

  .code-header { color: #93c5fd; }

  .specs-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .spec-pill {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1a6;
  }

  .spec-pill code {
    color: #ffffff;
    font-family: var(--font-mono);
  }

  .callout-tip {
    font-size: 12px;
    color: #86868b;
    padding: 8px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border-left: 3px solid var(--apple-blue);
  }

  .callout-tip code {
    color: #ffffff;
    font-size: 11px;
  }

  /* Endpoints Summary Table */
  .endpoints-summary {
    border-radius: 18px;
    background: rgba(14, 14, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 20px;
    margin-bottom: 24px;
  }

  .summary-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-size: 13.5px;
    color: #ffffff;
  }

  .endpoints-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: left;
    min-width: 600px;
  }

  .endpoints-table th {
    padding: 8px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #707078;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .endpoints-table td {
    padding: 11px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: #d1d1d6;
  }

  .endpoints-table tr:last-child td {
    border-bottom: none;
  }

  .badge-method {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .badge-method.post { background: rgba(41, 151, 255, 0.15); color: #60a5fa; }
  .badge-method.get { background: rgba(48, 209, 88, 0.15); color: #30d158; }
  .badge-method.delete { background: rgba(255, 69, 58, 0.15); color: #ff6961; }

  /* Snippet Showcase */
  .snippet-showcase {
    border-radius: 20px;
    background: #09090d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .snippet-tabs-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    gap: 12px;
  }

  .tabs-scroll-container {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .tab-btn {
    background: transparent;
    border: none;
    color: #86868b;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .tab-btn:hover {
    color: #ffffff;
  }

  .tab-btn.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .btn-copy-snippet {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f5f5f7;
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .btn-copy-snippet:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .tab-content {
    display: none;
    padding: 20px 24px;
    overflow-x: auto;
  }

  .tab-content.active {
    display: block;
  }

  .tab-content pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: #c9d1d9;
  }

  .c-comment { color: #6e7681; }

  .hidden { display: none !important; }

  @media (max-width: 860px) {
    .cdn-guide-section {
      padding: 24px 18px;
      border-radius: 20px;
    }
    .guide-header {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .btn-full-docs {
      justify-content: center;
      width: 100%;
    }
    .guide-grid {
      grid-template-columns: 1fr;
    }
    .param-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }

  @media (max-width: 550px) {
    .cdn-guide-section {
      padding: 20px 14px;
    }
    .snippet-tabs-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-copy-snippet {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script>
  // Tab switcher
  const tabBtns = document.querySelectorAll(".tab-btn");
  const tabContents = document.querySelectorAll(".tab-content");
  const copySnippetBtn = document.getElementById("copy-active-snippet");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tabId = (btn as HTMLElement).dataset.tab;

      tabBtns.forEach((b) => b.classList.remove("active"));
      tabContents.forEach((c) => c.classList.remove("active"));

      btn.classList.add("active");
      const targetContent = document.getElementById(`tab-${tabId}`);
      if (targetContent) targetContent.classList.add("active");
    });
  });

  // Copy active code snippet
  copySnippetBtn?.addEventListener("click", async () => {
    const activeTab = document.querySelector(".tab-content.active pre code");
    if (!activeTab) return;

    const textToCopy = activeTab.textContent || "";
    try {
      await navigator.clipboard.writeText(textToCopy);
      const copyIcon = copySnippetBtn.querySelector(".copy-icon");
      const checkIcon = copySnippetBtn.querySelector(".check-icon");
      const copyText = copySnippetBtn.querySelector(".copy-text");

      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyText) copyText.textContent = "Copied!";

      if (window.showToast) {
        window.showToast("Code snippet copied to clipboard");
      }

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyText) copyText.textContent = "Copy Code";
      }, 2000);
    } catch {
      prompt("Copy snippet:", textToCopy);
    }
  });

  // Copy URL button in card
  document.querySelectorAll(".btn-copy-code").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const copyVal = (btn as HTMLElement).dataset.copy || "";
      await navigator.clipboard.writeText(copyVal);
      const copyIcon = btn.querySelector(".copy-icon");
      const checkIcon = btn.querySelector(".check-icon");

      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");

      if (window.showToast) {
        window.showToast("CDN URL copied to clipboard");
      }

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
      }, 1800);
    });
  });
</script>
