---
import { UploadCloud, Image as ImageIcon, Copy, Check, ExternalLink, Search, Sparkles, Filter, Trash2, ArrowUpRight } from "lucide-astro";
---

<section id="storage" class="storage-section glass">
  <!-- Section Header -->
  <div class="storage-header">
    <div class="header-text">
      <div class="header-eyebrow">
        <ImageIcon size={14} class="eyebrow-icon" />
        <span>EDGE MEDIA STORAGE</span>
      </div>
      <h2>Asset Library & Direct Upload</h2>
      <p class="section-desc">
        Drag and drop high-resolution assets. ByteBucket instantly optimizes, compresses to WebP, and routes images to global edge locations.
      </p>
    </div>

    <div class="header-tools">
      <div class="search-box">
        <Search size={14} class="search-icon" />
        <input id="asset-search-input" type="text" placeholder="Filter assets..." />
      </div>
    </div>
  </div>

  <!-- Apple-Style Drag and Drop Zone -->
  <div id="dropzone" class="apple-dropzone">
    <input id="file-input" type="file" accept="image/*" multiple hidden />
    <div class="dropzone-content">
      <div class="drop-icon-wrap">
        <UploadCloud size={28} stroke-width={1.6} />
      </div>
      <div class="drop-text">
        <strong id="drop-status-main">Drop high-res images here</strong>
        <span id="drop-status-sub">or <button type="button" id="browse-btn" class="btn-browse">browse from your computer</button></span>
      </div>
      <div class="drop-specs">
        <span>Supports JPG, PNG, WebP, AVIF up to 25MB</span>
        <span>•</span>
        <span>Automatic WebP compression & Edge cache</span>
      </div>
    </div>

    <!-- Upload Progress Overlay -->
    <div id="upload-progress-wrap" class="upload-progress-wrap hidden">
      <div class="progress-bar-bg">
        <div id="upload-progress-fill" class="progress-bar-fill"></div>
      </div>
      <span id="upload-progress-text">Uploading and optimizing...</span>
    </div>
  </div>

  <!-- Assets Gallery Section -->
  <div class="gallery-wrapper">
    <div class="gallery-topbar">
      <div class="gallery-count">
        <span id="asset-count-label">3 assets stored</span>
        <span class="badge-synced">● Edge In-Sync</span>
      </div>

      <div class="gallery-sort-hint">
        <span>Click any asset to copy its production CDN URL</span>
      </div>
    </div>

    <!-- Gallery Grid -->
    <div id="asset-gallery" class="asset-grid">
      <!-- Dynamically filled with assets or fallback mock assets -->
    </div>
  </div>
</section>

<style>
  .storage-section {
    padding: 34px;
    margin-bottom: 24px;
  }

  .storage-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 28px;
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  .eyebrow-icon {
    stroke-width: 2.2;
  }

  .header-text h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .section-desc {
    color: #86868b;
    font-size: 14px;
    max-width: 620px;
    line-height: 1.5;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 10, 14, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 6px 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--apple-blue);
    box-shadow: 0 0 0 3px rgba(41, 151, 255, 0.15);
  }

  .search-icon {
    color: #86868b;
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 12.5px;
    font-family: inherit;
    width: 130px;
    transition: width 0.2s ease;
  }

  .search-box input:focus {
    width: 180px;
  }

  /* Apple-Style Dropzone */
  .apple-dropzone {
    position: relative;
    border: 1.5px dashed rgba(255, 255, 255, 0.14);
    border-radius: 22px;
    background: rgba(14, 14, 18, 0.4);
    padding: 38px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    margin-bottom: 28px;
  }

  .apple-dropzone:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(20, 20, 26, 0.55);
  }

  .apple-dropzone.dragging {
    border-color: var(--apple-blue);
    background: rgba(41, 151, 255, 0.08);
    box-shadow: 0 0 30px rgba(41, 151, 255, 0.2);
    transform: scale(1.008);
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .drop-icon-wrap {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f5f5f7;
    margin-bottom: 4px;
    transition: transform 0.2s ease;
  }

  .apple-dropzone:hover .drop-icon-wrap {
    transform: translateY(-2px);
    color: var(--apple-blue);
    border-color: rgba(41, 151, 255, 0.3);
  }

  .drop-text strong {
    display: block;
    font-size: 16px;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .drop-text span {
    font-size: 13px;
    color: #86868b;
  }

  .btn-browse {
    background: transparent;
    border: none;
    color: var(--apple-blue);
    font-size: 13px;
    font-weight: 550;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0;
  }

  .drop-specs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: #707078;
    margin-top: 4px;
  }

  /* Upload Progress */
  .upload-progress-wrap {
    position: absolute;
    inset: 0;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(10px);
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .progress-bar-bg {
    width: 260px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 45%;
    background: linear-gradient(90deg, var(--apple-blue), #818cf8);
    border-radius: 999px;
    animation: progressIndeterminate 1.5s infinite ease-in-out;
  }

  @keyframes progressIndeterminate {
    0% { transform: translateX(-100%); width: 30%; }
    50% { transform: translateX(50%); width: 60%; }
    100% { transform: translateX(250%); width: 30%; }
  }

  .upload-progress-wrap span {
    font-size: 12.5px;
    color: #d1d1d6;
  }

  /* Gallery Topbar */
  .gallery-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gallery-count {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
  }

  .badge-synced {
    font-size: 10.5px;
    font-weight: 500;
    color: #30d158;
    background: rgba(48, 209, 88, 0.12);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(48, 209, 88, 0.25);
  }

  .gallery-sort-hint {
    font-size: 11.5px;
    color: #86868b;
  }

  /* Asset Grid */
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  /* Dynamic Asset Card Styling */
  :global(.asset-card) {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(14, 14, 18, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  :global(.asset-card:hover) {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }

  :global(.asset-preview-wrap) {
    position: relative;
    height: 170px;
    width: 100%;
    background-color: #08080b;
    overflow: hidden;
  }

  :global(.asset-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  :global(.asset-card:hover .asset-img) {
    transform: scale(1.05);
  }

  :global(.asset-format-badge) {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 10.5px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  :global(.asset-info) {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(10, 10, 14, 0.8);
    flex: 1;
  }

  :global(.asset-title) {
    font-size: 13.5px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.asset-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: #86868b;
  }

  :global(.asset-actions) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.btn-copy-cdn) {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 550;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.btn-copy-cdn:hover) {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
  }

  :global(.btn-copy-cdn.copied) {
    background: rgba(48, 209, 88, 0.18);
    border-color: rgba(48, 209, 88, 0.4);
    color: #30d158;
  }

  :global(.btn-open-preview) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a1a1a6;
    transition: all 0.15s ease;
  }

  :global(.btn-open-preview:hover) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 820px) {
    .storage-section {
      padding: 24px;
    }
    .storage-header {
      flex-direction: column;
    }
    .header-tools {
      width: 100%;
    }
    .search-box {
      width: 100%;
    }
    .search-box input {
      width: 100%;
    }
  }

  @media (max-width: 650px) {
    .storage-section {
      padding: 20px 16px;
      border-radius: 20px;
    }
    .apple-dropzone {
      padding: 26px 14px;
    }
    .drop-specs {
      flex-direction: column;
      gap: 3px;
    }
    .drop-specs span:nth-child(2) {
      display: none;
    }
    .gallery-topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .asset-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || "https://bytebucket.hayproject.my.id";
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("file-input") as HTMLInputElement | null;
  const browseBtn = document.getElementById("browse-btn");
  const gallery = document.getElementById("asset-gallery");
  const searchInput = document.getElementById("asset-search-input") as HTMLInputElement | null;
  const countLabel = document.getElementById("asset-count-label");
  const progressWrap = document.getElementById("upload-progress-wrap");

  // High quality sample images showcasing the Apple aesthetic
  const mockAssets = [
    {
      id: "img-1",
      original_name: "apple-pro-display-retina.jpg",
      cdn_url: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1200&q=85",
      size_bytes: 482000,
      width: 2400,
      height: 1600,
      mime_type: "image/webp",
      created_at: new Date(Date.now() - 3600000 * 3).toISOString(),
    },
    {
      id: "img-2",
      original_name: "macos-sequoia-abstract.png",
      cdn_url: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=85",
      size_bytes: 312000,
      width: 1920,
      height: 1080,
      mime_type: "image/webp",
      created_at: new Date(Date.now() - 86400000 * 2).toISOString(),
    },
    {
      id: "img-3",
      original_name: "titanium-chassis-macro.jpg",
      cdn_url: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=85",
      size_bytes: 654000,
      width: 2560,
      height: 1440,
      mime_type: "image/webp",
      created_at: new Date(Date.now() - 86400000 * 5).toISOString(),
    },
  ];

  let currentAssets = [...mockAssets];

  // Browse click
  browseBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    fileInput?.click();
  });
  dropzone?.addEventListener("click", () => fileInput?.click());

  // Drag and drop events
  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("dragging");
  });

  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("dragging");
  });

  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("dragging");
    if (e.dataTransfer?.files?.length) {
      handleUpload(e.dataTransfer.files);
    }
  });

  fileInput?.addEventListener("change", () => {
    if (fileInput.files?.length) {
      handleUpload(fileInput.files);
    }
  });

  // Upload handler
  async function handleUpload(files: FileList) {
    if (!files || files.length === 0) return;
    progressWrap?.classList.remove("hidden");

    const token = localStorage.getItem("cloudpixel_token") || "";
    const apiKey = localStorage.getItem("cloudpixel_api_key") || "";

    const formData = new FormData();
    const count = Math.min(files.length, 10);
    for (let i = 0; i < count; i++) {
      formData.append("images", files[i]);
    }

    try {
      const headers: Record<string, string> = {};
      if (apiKey) headers["X-API-Key"] = apiKey;
      else if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch(`${API_BASE}/api/v1/upload`, {
        method: "POST",
        headers,
        body: formData,
      });

      if (res.ok) {
        const body = await res.json();
        const items = Array.isArray(body.data) ? body.data : [body.data];
        items.forEach((item: any) => {
          currentAssets.unshift({
            id: item.id || `img-${Date.now()}`,
            original_name: item.original_name || "uploaded_image.webp",
            cdn_url: item.cdn_url,
            size_bytes: item.size_bytes || 250000,
            width: 1600,
            height: 900,
            mime_type: "image/webp",
            created_at: new Date().toISOString(),
          });
        });

        if (window.showToast) {
          window.showToast(`${items.length} image(s) optimized & uploaded`);
        }
      } else {
        // Create local preview mockup if backend not connected
        Array.from(files).slice(0, 3).forEach((file) => {
          const fakeUrl = URL.createObjectURL(file);
          currentAssets.unshift({
            id: `local-${Date.now()}`,
            original_name: file.name,
            cdn_url: fakeUrl,
            size_bytes: file.size,
            width: 1920,
            height: 1080,
            mime_type: "image/webp",
            created_at: new Date().toISOString(),
          });
        });

        if (window.showToast) {
          window.showToast(`${files.length} image(s) processed for preview`);
        }
      }
    } catch {
      // Offline fallback: create local preview
      Array.from(files).slice(0, 3).forEach((file) => {
        const fakeUrl = URL.createObjectURL(file);
        currentAssets.unshift({
          id: `local-${Date.now()}`,
          original_name: file.name,
          cdn_url: fakeUrl,
          size_bytes: file.size,
          width: 1920,
          height: 1080,
          mime_type: "image/webp",
          created_at: new Date().toISOString(),
        });
      });

      if (window.showToast) {
        window.showToast("Files processed for local preview");
      }
    } finally {
      progressWrap?.classList.add("hidden");
      renderGallery(currentAssets);
    }
  }

  // Load existing images from backend
  async function fetchImages() {
    const token = localStorage.getItem("cloudpixel_token");
    if (!token) {
      renderGallery(currentAssets);
      return;
    }

    try {
      const res = await fetch(`${API_BASE}/api/images`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const body = await res.json();
        if (body.data?.length) {
          currentAssets = body.data;
        }
      }
    } catch {
      // Use mock
    }
    renderGallery(currentAssets);
  }

  // Render gallery
  function renderGallery(assets: any[]) {
    if (!gallery) return;

    if (countLabel) {
      countLabel.textContent = `${assets.length} asset${assets.length === 1 ? "" : "s"} stored`;
    }

    if (assets.length === 0) {
      gallery.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #86868b;">
          <p>No media assets uploaded yet. Drop an image above to start.</p>
        </div>
      `;
      return;
    }

    gallery.innerHTML = assets
      .map((item) => {
        const kbSize = Math.round(item.size_bytes / 1024);
        const name = item.original_name || "image.webp";
        const cdnUrl = item.cdn_url || "#";

        return `
          <article class="asset-card" data-name="${name.toLowerCase()}">
            <div class="asset-preview-wrap">
              <img src="${cdnUrl}" alt="${name}" class="asset-img" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80'" />
              <span class="asset-format-badge">WEBP</span>
            </div>
            <div class="asset-info">
              <strong class="asset-title" title="${name}">${name}</strong>
              <div class="asset-meta">
                <span>${kbSize} KB</span>
                <span>Edge Cached</span>
              </div>
              <div class="asset-actions">
                <button class="btn-copy-cdn" data-url="${cdnUrl}" title="Copy optimized CDN URL">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="copy-label">Copy CDN URL</span>
                </button>
                <a href="${cdnUrl}" target="_blank" rel="noopener" class="btn-open-preview" title="Open asset in new tab">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        `;
      })
      .join("");

    attachCopyListeners();
  }

  // Copy CDN URL listener
  function attachCopyListeners() {
    document.querySelectorAll(".btn-copy-cdn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = (btn as HTMLElement).dataset.url || "";
        try {
          await navigator.clipboard.writeText(url);
          const label = btn.querySelector(".copy-label");
          if (label) label.textContent = "Copied!";
          btn.classList.add("copied");

          if (window.showToast) {
            window.showToast("CDN URL copied to clipboard");
          }

          setTimeout(() => {
            if (label) label.textContent = "Copy CDN URL";
            btn.classList.remove("copied");
          }, 1800);
        } catch {
          prompt("Copy CDN URL:", url);
        }
      });
    });
  }

  // Filter search
  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.toLowerCase().trim();
    const cards = document.querySelectorAll(".asset-card");
    cards.forEach((card) => {
      const name = (card as HTMLElement).dataset.name || "";
      if (!query || name.includes(query)) {
        (card as HTMLElement).style.display = "";
      } else {
        (card as HTMLElement).style.display = "none";
      }
    });
  });

  fetchImages();
</script>
