---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "danger" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  id?: string;
  class?: string;
  disabled?: boolean;
  target?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  id,
  class: className = "",
  disabled = false,
  target,
} = Astro.props;

const classes = [
  "apple-btn",
  `btn-${variant}`,
  `btn-${size}`,
  className,
].filter(Boolean).join(" ");
---

{
  href ? (
    <a href={href} class={classes} id={id} target={target}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id} disabled={disabled}>
      <slot />
    </button>
  )
}

<style>
  .apple-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 9999px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    border: 1px solid transparent;
    user-select: none;
  }

  /* Size Variants */
  .btn-sm {
    padding: 6px 14px;
    font-size: 12px;
  }

  .btn-md {
    padding: 10px 20px;
    font-size: 13.5px;
  }

  .btn-lg {
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
  }

  /* Primary Apple Button (Pure White Pill with dark text) */
  .btn-primary {
    background: #ffffff;
    color: #000000;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.12);
  }

  .btn-primary:hover {
    background: #f0f0f2;
    transform: translateY(-1px) scale(1.01);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.22);
  }

  .btn-primary:active {
    transform: translateY(0) scale(0.99);
  }

  /* Secondary Button (Frosted Dark Glass with subtle border) */
  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #f5f5f7;
    border-color: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(255, 255, 255, 0.24);
    transform: translateY(-1px);
    color: #ffffff;
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  /* Danger Button (Subtle Red Glass for Revoke/Delete) */
  .btn-danger {
    background: rgba(255, 69, 58, 0.12);
    color: #ff6961;
    border-color: rgba(255, 69, 58, 0.28);
    backdrop-filter: blur(16px);
  }

  .btn-danger:hover {
    background: rgba(255, 69, 58, 0.22);
    border-color: rgba(255, 69, 58, 0.45);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(255, 69, 58, 0.2);
  }

  /* Ghost Button */
  .btn-ghost {
    background: transparent;
    color: #a1a1a6;
  }

  .btn-ghost:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .apple-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }
</style>
