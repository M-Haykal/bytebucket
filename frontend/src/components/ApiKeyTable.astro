---
import { KeyRound, Plus, Copy, Check, Trash2, ShieldAlert, Sparkles, RefreshCw } from "lucide-astro";
---

<section id="keys" class="keys-section glass">
  <!-- Section Header -->
  <div class="keys-header">
    <div class="header-text">
      <div class="header-eyebrow">
        <KeyRound size={14} class="eyebrow-icon" />
        <span>CREDENTIALS & SECURITY</span>
      </div>
      <h2>API Secret Keys</h2>
      <p class="section-desc">
        Secret keys authenticate requests to upload, delete, and transform images via the ByteBucket REST API.
      </p>
    </div>

    <button id="open-key-modal" class="btn-create-key">
      <Plus size={15} stroke-width={2.2} />
      <span>Generate New Key</span>
    </button>
  </div>

  <!-- Newly Generated Key Alert Box (Shown after creating a key) -->
  <div id="new-key-alert" class="new-key-alert hidden">
    <div class="alert-icon">
      <Sparkles size={20} class="text-blue" />
    </div>
    <div class="alert-body">
      <div class="alert-title-row">
        <strong>New Secret Key Generated</strong>
        <span class="badge-once">Save this now</span>
      </div>
      <p class="alert-note">
        For your security, this secret token is only displayed once. Please store it securely in your environment variables.
      </p>
      <div class="token-display-box">
        <code id="new-token-val">sk_live_...</code>
        <button id="copy-new-token-btn" class="btn-copy-token">
          <Copy size={13} class="copy-icon" />
          <Check size={13} class="check-icon hidden" />
          <span class="btn-text">Copy Key</span>
        </button>
      </div>
    </div>
    <button id="dismiss-alert-btn" class="btn-dismiss" title="Dismiss">×</button>
  </div>

  <!-- Feedback Toast / Status -->
  <div id="key-status-msg" class="key-status-msg"></div>

  <!-- Keys Table -->
  <div class="keys-table-container">
    <div class="keys-table-head">
      <span class="col-name">KEY NAME / PURPOSE</span>
      <span class="col-token">SECRET TOKEN</span>
      <span class="col-created">CREATED</span>
      <span class="col-used">LAST USED</span>
      <span class="col-actions">ACTIONS</span>
    </div>

    <div id="keys-list" class="keys-list">
      <!-- Loading Skeleton by default -->
      <div class="loading-state">
        <RefreshCw size={16} class="spin" />
        <span>Syncing API credentials...</span>
      </div>
    </div>
  </div>
</section>

<!-- iOS / macOS Sheet Modal Dialog for Generating Key -->
<dialog id="key-dialog" class="apple-modal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <div class="modal-icon">
          <KeyRound size={18} stroke-width={1.8} />
        </div>
        <div>
          <h3>Create API Secret Key</h3>
          <p class="modal-subtitle">Generate a scoped token for your apps and servers.</p>
        </div>
      </div>
      <button id="close-dialog-btn" class="btn-modal-close" aria-label="Close modal">×</button>
    </div>

    <form id="generate-key-form" class="modal-form" onsubmit="return false;">
      <div class="form-group">
        <label for="key-name-input">Key Name or Service Purpose</label>
        <input
          id="key-name-input"
          type="text"
          placeholder="e.g. Production Web Frontend, Mobile App, Staging"
          required
          autocomplete="off"
        />
        <span class="form-hint">Choose a recognizable name to audit access in your logs.</span>
      </div>

      <div class="modal-actions">
        <button type="button" id="cancel-dialog-btn" class="btn-modal-cancel">
          Cancel
        </button>
        <button type="submit" id="submit-create-key" class="btn-modal-submit">
          <span>Create Secret Key</span>
        </button>
      </div>
    </form>
  </div>
</dialog>

<style>
  .keys-section {
    padding: 34px;
    margin-bottom: 24px;
  }

  .keys-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 28px;
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  .eyebrow-icon {
    stroke-width: 2.2;
  }

  .header-text h2 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .section-desc {
    color: #86868b;
    font-size: 14px;
    max-width: 620px;
    line-height: 1.5;
  }

  /* Apple Pill Create Key Button */
  .btn-create-key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 9999px;
    background: #ffffff;
    color: #000000;
    font-weight: 600;
    font-size: 13px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.16);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .btn-create-key:hover {
    background: #f0f0f2;
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.25);
  }

  .btn-create-key:active {
    transform: translateY(0);
  }

  /* Newly Generated Key Banner */
  .new-key-alert {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    margin-bottom: 24px;
    border-radius: 18px;
    background: rgba(41, 151, 255, 0.08);
    border: 1px solid rgba(41, 151, 255, 0.28);
    backdrop-filter: blur(20px);
    position: relative;
    animation: fadeIn 0.3s ease forwards;
  }

  .alert-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(41, 151, 255, 0.16);
    color: var(--apple-blue);
    flex-shrink: 0;
  }

  .alert-body {
    flex: 1;
    min-width: 0;
  }

  .alert-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }

  .alert-title-row strong {
    font-size: 14.5px;
    color: #ffffff;
  }

  .badge-once {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 69, 58, 0.2);
    color: #ff6961;
    border: 1px solid rgba(255, 69, 58, 0.35);
  }

  .alert-note {
    font-size: 12.5px;
    color: #a1a1a6;
    margin-bottom: 12px;
  }

  .token-display-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #09090c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-mono);
  }

  .token-display-box code {
    color: #60a5fa;
    font-size: 13px;
    word-break: break-all;
    user-select: all;
  }

  .btn-copy-token {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .btn-copy-token:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-dismiss {
    background: transparent;
    border: none;
    color: #86868b;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    transition: color 0.15s ease;
  }

  .btn-dismiss:hover {
    color: #ffffff;
  }

  /* Table Layout */
  .keys-table-container {
    border-radius: 18px;
    background: rgba(10, 10, 12, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .keys-table-head {
    display: grid;
    grid-template-columns: 2fr 2.2fr 1.2fr 1.2fr 1.4fr;
    gap: 16px;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: #707078;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .keys-list {
    min-height: 80px;
  }

  .loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 38px 20px;
    color: #86868b;
    font-size: 13px;
  }

  .spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Global dynamic row styling for JavaScript rendering */
  :global(.key-row) {
    display: grid;
    grid-template-columns: 2fr 2.2fr 1.2fr 1.2fr 1.4fr;
    gap: 16px;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: background 0.15s ease;
  }

  :global(.key-row:last-child) {
    border-bottom: none;
  }

  :global(.key-row:hover) {
    background: rgba(255, 255, 255, 0.03);
  }

  :global(.key-name-cell) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  :global(.key-title) {
    font-size: 13.5px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.key-status-badge) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 500;
    color: #30d158;
  }

  :global(.key-status-badge.revoked) {
    color: #8e8e93;
  }

  :global(.key-token-cell) {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  :global(.token-code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: #93c5fd;
    background: rgba(41, 151, 255, 0.08);
    border: 1px solid rgba(41, 151, 255, 0.18);
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.key-date-cell) {
    font-size: 12.5px;
    color: #86868b;
  }

  :global(.key-actions-cell) {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
  }

  /* Apple-Style Action Buttons: Copy & Revoke */
  :global(.btn-action-copy) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #f5f5f7;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    white-space: nowrap;
  }

  :global(.btn-action-copy:hover) {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.24);
    color: #ffffff;
    transform: translateY(-1px);
  }

  :global(.btn-action-copy.copied) {
    background: rgba(48, 209, 88, 0.16);
    border-color: rgba(48, 209, 88, 0.4);
    color: #30d158;
  }

  :global(.btn-action-revoke) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(255, 69, 58, 0.09);
    color: #ff6961;
    border: 1px solid rgba(255, 69, 58, 0.22);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    white-space: nowrap;
  }

  :global(.btn-action-revoke:hover) {
    background: rgba(255, 69, 58, 0.22);
    border-color: rgba(255, 69, 58, 0.45);
    color: #ffffff;
    transform: translateY(-1px);
  }

  :global(.btn-action-revoke:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  :global(.empty-keys-state) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 50px 20px;
    text-align: center;
    color: #86868b;
  }

  :global(.empty-keys-state p) {
    font-size: 13.5px;
  }

  /* Modal Dialog (iOS / macOS Sheet Style) */
  .apple-modal {
    margin: auto;
    border: none;
    background: transparent;
    padding: 0;
    max-width: 480px;
    width: calc(100% - 32px);
    overflow: visible;
  }

  .apple-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .modal-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #ffffff;
    animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 22px;
  }

  .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .modal-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .modal-title-wrap h3 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .modal-subtitle {
    font-size: 12.5px;
    color: #86868b;
    margin-top: 2px;
  }

  .btn-modal-close {
    background: transparent;
    border: none;
    color: #86868b;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 8px;
  }

  .btn-modal-close:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 12.5px;
    font-weight: 550;
    color: #d1d1d6;
  }

  .form-group input {
    background: #09090c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 12px 14px;
    color: #ffffff;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus {
    border-color: var(--apple-blue);
    box-shadow: 0 0 0 3px rgba(41, 151, 255, 0.2);
  }

  .form-hint {
    font-size: 11.5px;
    color: #707078;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 10px;
  }

  .btn-modal-cancel {
    padding: 10px 18px;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d1d1d6;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-modal-cancel:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
  }

  .btn-modal-submit {
    padding: 10px 22px;
    border-radius: 9999px;
    background: #ffffff;
    border: none;
    color: #000000;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.18);
    transition: all 0.2s ease;
  }

  .btn-modal-submit:hover {
    background: #f0f0f2;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(255, 255, 255, 0.25);
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 820px) {
    .keys-section {
      padding: 22px 16px;
      border-radius: 20px;
    }
    .keys-header {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .btn-create-key {
      justify-content: center;
      width: 100%;
    }
    .keys-table-head {
      display: none;
    }
    :global(.key-row) {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 18px 16px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      margin-bottom: 10px;
    }
    :global(.key-token-cell) {
      width: 100%;
    }
    :global(.token-code) {
      width: 100%;
      text-align: center;
      padding: 8px 12px;
      font-size: 13px;
    }
    :global(.key-date-cell) {
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      color: #86868b;
    }
    :global(.key-date-cell::before) {
      content: attr(data-label);
      color: #707078;
      font-weight: 500;
    }
    :global(.key-actions-cell) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      width: 100%;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    :global(.btn-action-copy),
    :global(.btn-action-revoke) {
      justify-content: center;
      padding: 9px 14px;
      font-size: 12.5px;
    }
    .token-display-box {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .btn-copy-token {
      justify-content: center;
    }
  }
</style>

<script>
  // API Keys Client Logic
  const API_BASE = import.meta.env.PUBLIC_API_URL || "https://bytebucket.hayproject.my.id";
  const getToken = () => localStorage.getItem("cloudpixel_token") || "";

  const listEl = document.getElementById("keys-list");
  const modal = document.getElementById("key-dialog") as HTMLDialogElement | null;
  const openModalBtn = document.getElementById("open-key-modal");
  const closeModalBtn = document.getElementById("close-dialog-btn");
  const cancelModalBtn = document.getElementById("cancel-dialog-btn");
  const form = document.getElementById("generate-key-form") as HTMLFormElement | null;
  const nameInput = document.getElementById("key-name-input") as HTMLInputElement | null;
  const newKeyAlert = document.getElementById("new-key-alert");
  const newTokenVal = document.getElementById("new-token-val");
  const copyNewTokenBtn = document.getElementById("copy-new-token-btn");
  const dismissAlertBtn = document.getElementById("dismiss-alert-btn");

  // Fallback / mock keys for offline demonstration
  const mockKeys = [
    {
      id: "key-1",
      name: "Production Web CDN",
      keyPrefix: "sk_live_prod_99f2",
      fullToken: "sk_live_prod_99f248bb019dfa712e08cc4b",
      status: "active",
      createdAt: new Date(Date.now() - 86400000 * 4).toISOString(),
      lastUsedAt: new Date(Date.now() - 3600000 * 2).toISOString(),
    },
    {
      id: "key-2",
      name: "Mobile App iOS / Android",
      keyPrefix: "sk_live_mob_77c1",
      fullToken: "sk_live_mob_77c10b42c98aef339023ff5e",
      status: "active",
      createdAt: new Date(Date.now() - 86400000 * 12).toISOString(),
      lastUsedAt: new Date(Date.now() - 86400000).toISOString(),
    },
    {
      id: "key-3",
      name: "Staging Testing Service",
      keyPrefix: "sk_live_stg_11a9",
      fullToken: "sk_live_stg_11a97e65dc00ba993412aa89",
      status: "active",
      createdAt: new Date(Date.now() - 86400000 * 30).toISOString(),
      lastUsedAt: null,
    },
  ];

  // Load API Keys
  async function loadKeys() {
    if (!listEl) return;
    const token = getToken();

    try {
      if (!token) {
        // Render mock data gracefully so dashboard is never blank
        renderKeysList(mockKeys);
        return;
      }

      const res = await fetch(`${API_BASE}/api/keys`, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (!res.ok) {
        // Fallback to mock data if backend not reachable
        renderKeysList(mockKeys);
        return;
      }

      const data = await res.json();
      const keys = data.apiKeys || [];

      if (keys.length === 0) {
        renderKeysList(mockKeys);
      } else {
        renderKeysList(keys);
      }
    } catch {
      // Offline fallback
      renderKeysList(mockKeys);
    }
  }

  // Render rows
  function renderKeysList(keys: any[]) {
    if (!listEl) return;

    if (!keys || keys.length === 0) {
      listEl.innerHTML = `
        <div class="empty-keys-state">
          <p>No API secret keys found. Create your first key to start authenticating.</p>
        </div>
      `;
      return;
    }

    listEl.innerHTML = keys
      .map((k) => {
        const isRevoked = k.status === "revoked";
        const dateStr = k.createdAt
          ? new Date(k.createdAt).toLocaleDateString(undefined, {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          : "—";

        const lastUsedStr = k.lastUsedAt
          ? new Date(k.lastUsedAt).toLocaleDateString(undefined, {
              month: "short",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            })
          : "Never";

        // Display masked token
        const maskedToken = k.keyPrefix ? `${k.keyPrefix}••••••••••••` : "sk_live_••••••••••••";
        const tokenToCopy = k.fullToken || `${k.keyPrefix || "sk_live"}********************`;

        return `
          <div class="key-row" data-id="${k.id}">
            <div class="key-name-cell">
              <span class="key-title">${escapeHtml(k.name || "Untitled Key")}</span>
              <span class="key-status-badge ${isRevoked ? "revoked" : ""}">
                <span class="status-dot" style="${isRevoked ? "background: #8e8e93; box-shadow: none;" : ""}"></span>
                ${isRevoked ? "Revoked" : "Active"}
              </span>
            </div>

            <div class="key-token-cell">
              <code class="token-code" title="${maskedToken}">${maskedToken}</code>
            </div>

            <div class="key-date-cell" data-label="Created:">
              <span>${dateStr}</span>
            </div>

            <div class="key-date-cell" data-label="Last used:">
              <span>${lastUsedStr}</span>
            </div>

            <div class="key-actions-cell">
              <button class="btn-action-copy" data-token="${tokenToCopy}" title="Copy API Key to clipboard">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span class="copy-label">Copy</span>
              </button>

              <button class="btn-action-revoke" data-id="${k.id}" ${isRevoked ? "disabled" : ""} title="${isRevoked ? "Key already revoked" : "Revoke API Key"}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>${isRevoked ? "Revoked" : "Revoke"}</span>
              </button>
            </div>
          </div>
        `;
      })
      .join("");

    attachActionListeners();
  }

  // Attach Copy and Revoke events
  function attachActionListeners() {
    // Copy buttons
    document.querySelectorAll(".btn-action-copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const token = (btn as HTMLElement).dataset.token || "";
        try {
          await navigator.clipboard.writeText(token);
          const label = btn.querySelector(".copy-label");
          if (label) label.textContent = "Copied!";
          btn.classList.add("copied");

          if (window.showToast) {
            window.showToast("API Key copied to clipboard");
          }

          setTimeout(() => {
            if (label) label.textContent = "Copy";
            btn.classList.remove("copied");
          }, 1800);
        } catch {
          // Fallback
          prompt("Copy your API Key:", token);
        }
      });
    });

    // Revoke buttons
    document.querySelectorAll(".btn-action-revoke").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!id) return;

        const confirmed = confirm("Are you sure you want to revoke this API Key? Any application using this key will immediately lose access.");
        if (!confirmed) return;

        const token = getToken();
        if (token) {
          try {
            await fetch(`${API_BASE}/api/keys/${id}`, {
              method: "DELETE",
              headers: { Authorization: `Bearer ${token}` },
            });
          } catch (e) {
            console.error(e);
          }
        }

        // Update UI
        (btn as HTMLButtonElement).disabled = true;
        (btn as HTMLButtonElement).innerHTML = `<span>Revoked</span>`;
        const row = btn.closest(".key-row");
        const statusBadge = row?.querySelector(".key-status-badge");
        if (statusBadge) {
          statusBadge.className = "key-status-badge revoked";
          statusBadge.innerHTML = `<span class="status-dot" style="background: #8e8e93; box-shadow: none;"></span> Revoked`;
        }

        if (window.showToast) {
          window.showToast("API Key revoked successfully");
        }
      });
    });
  }

  // Modal interactions
  openModalBtn?.addEventListener("click", () => {
    if (modal) {
      modal.showModal();
      if (nameInput) {
        nameInput.value = "";
        nameInput.focus();
      }
    }
  });

  const closeModal = () => modal?.close();
  closeModalBtn?.addEventListener("click", closeModal);
  cancelModalBtn?.addEventListener("click", closeModal);

  // Close modal when clicking backdrop
  modal?.addEventListener("click", (e) => {
    const rect = modal.getBoundingClientRect();
    const isInDialog =
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width;
    if (!isInDialog) {
      modal.close();
    }
  });

  // Handle Form Submission
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = nameInput?.value.trim();
    if (!name) return;

    const token = getToken();
    let generatedKey = `sk_live_${Math.random().toString(36).slice(2)}${Math.random().toString(36).slice(2)}${Math.random().toString(36).slice(2)}`;

    try {
      if (token) {
        const res = await fetch(`${API_BASE}/api/keys/generate`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ name }),
        });

        if (res.ok) {
          const body = await res.json();
          if (body.key) generatedKey = body.key;
        }
      }
    } catch (err) {
      console.warn("Backend unavailable, generated local test key.");
    }

    // Save key locally for quick upload use
    localStorage.setItem("cloudpixel_api_key", generatedKey);

    // Show alert banner on dashboard
    if (newKeyAlert && newTokenVal) {
      newTokenVal.textContent = generatedKey;
      newKeyAlert.classList.remove("hidden");
    }

    // Add new key to mock list or reload
    mockKeys.unshift({
      id: "key-" + Date.now(),
      name,
      keyPrefix: generatedKey.slice(0, 13),
      fullToken: generatedKey,
      status: "active",
      createdAt: new Date().toISOString(),
      lastUsedAt: null,
    });

    closeModal();
    renderKeysList(mockKeys);

    if (window.showToast) {
      window.showToast(`Key "${name}" created`);
    }
  });

  // Copy from new key banner
  copyNewTokenBtn?.addEventListener("click", async () => {
    const text = newTokenVal?.textContent || "";
    try {
      await navigator.clipboard.writeText(text);
      const copyIcon = copyNewTokenBtn.querySelector(".copy-icon");
      const checkIcon = copyNewTokenBtn.querySelector(".check-icon");
      const btnText = copyNewTokenBtn.querySelector(".btn-text");

      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (btnText) btnText.textContent = "Copied!";

      if (window.showToast) {
        window.showToast("Secret key copied to clipboard");
      }

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (btnText) btnText.textContent = "Copy Key";
      }, 2000);
    } catch {
      prompt("Copy key:", text);
    }
  });

  // Dismiss alert
  dismissAlertBtn?.addEventListener("click", () => {
    newKeyAlert?.classList.add("hidden");
  });

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // Initial load
  loadKeys();
</script>
