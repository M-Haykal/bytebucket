---
import { Box, Key, FileCode, Menu, X, ArrowUpRight, Sparkles, Image as ImageIcon } from "lucide-astro";

interface Props {
  dashboard?: boolean;
}

const { dashboard = false } = Astro.props;
---

<header class="navbar-wrapper">
  <div class="nav-container glass">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="ByteBucket Home">
      <div class="brand-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="brand-name">ByteBucket</span>
      <span class="brand-badge">CDN</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="nav-links">
      {
        dashboard ? (
          <>
            <a href="/dashboard" class="nav-link active">Console</a>
            <a href="/dashboard#keys" class="nav-link">API Keys</a>
            <a href="/dashboard#storage" class="nav-link">Media Library</a>
            <a href="/dashboard#cdn-docs" class="nav-link">API Guide</a>
            <a href="/docs" class="nav-link">Full Docs</a>
          </>
        ) : (
          <>
            <a href="/" class="nav-link">Overview</a>
            <a href="/#demo" class="nav-link">Live Demo</a>
            <a href="/#features" class="nav-link">Features</a>
            <a href="/docs" class="nav-link">API Docs</a>
            <a href="/dashboard" class="nav-link">Console</a>
          </>
        )
      }
    </nav>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <div class="network-status" title="Global Edge Operational">
        <span class="status-dot"></span>
        <span class="status-label">Global Edge</span>
      </div>

      {
        dashboard ? (
          <a href="/" class="action-btn back-btn">
            <span>Website</span>
            <ArrowUpRight size={13} stroke-width={2} />
          </a>
        ) : (
          <div class="auth-buttons">
            <a href="/login" class="nav-link login-link">Sign In</a>
            <a href="/dashboard" class="action-btn primary-btn">
              <span>Launch Console</span>
              <ArrowUpRight size={13} stroke-width={2} />
            </a>
          </div>
        )
      }

      <!-- Mobile Menu Button -->
      <button id="mobile-toggle" class="mobile-toggle" aria-label="Toggle Navigation">
        <Menu size={20} class="menu-open" stroke-width={1.5} />
        <X size={20} class="menu-close hidden" stroke-width={1.5} />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer glass hidden">
    <nav class="mobile-nav-links">
      {
        dashboard ? (
          <>
            <a href="/dashboard" class="mobile-link">Developer Console</a>
            <a href="/dashboard#keys" class="mobile-link">API Keys Management</a>
            <a href="/dashboard#storage" class="mobile-link">Media Library</a>
            <a href="/dashboard#cdn-docs" class="mobile-link">CDN Usage Guide</a>
            <a href="/docs" class="mobile-link">Documentation</a>
            <a href="/" class="mobile-link">Exit to Landing</a>
          </>
        ) : (
          <>
            <a href="/" class="mobile-link">Overview</a>
            <a href="/#demo" class="mobile-link">Interactive Demo</a>
            <a href="/#features" class="mobile-link">Features</a>
            <a href="/docs" class="mobile-link">Documentation</a>
            <a href="/dashboard" class="mobile-link">Developer Console</a>
            <div class="mobile-auth-divider"></div>
            <a href="/login" class="mobile-link">Sign In</a>
            <a href="/register" class="mobile-link highlight">Create Free Account</a>
          </>
        )
      }
    </nav>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 16px;
    z-index: 100;
    width: min(1160px, calc(100% - 32px));
    margin: 16px auto 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    border-radius: 9999px;
    background: rgba(10, 10, 12, 0.72);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #ffffff;
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: -0.03em;
  }

  .brand-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(135deg, #2c2d35 0%, #15161c 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  .brand-name {
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .brand-badge {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(41, 151, 255, 0.14);
    color: var(--apple-blue);
    border: 1px solid rgba(41, 151, 255, 0.25);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 450;
    color: #86868b;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link.active {
    color: #ffffff;
    font-weight: 550;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .network-status {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.2);
    font-size: 11px;
    font-weight: 500;
    color: #a3e7b7;
  }

  .auth-buttons {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .login-link {
    font-size: 13px;
    color: #a1a1a6;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 9999px;
    font-size: 12.5px;
    font-weight: 500;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .primary-btn {
    background: #ffffff;
    color: #000000;
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
  }

  .primary-btn:hover {
    background: #ebebed;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
  }

  .back-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #e5e5ea;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .back-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.22);
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: #f5f5f7;
    cursor: pointer;
    padding: 4px;
  }

  .hidden {
    display: none !important;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    margin-top: 10px;
    padding: 16px;
    border-radius: 20px;
    background: rgba(14, 14, 18, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-link {
    font-size: 14px;
    color: #a1a1a6;
    padding: 8px 12px;
    border-radius: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .mobile-link.highlight {
    color: #ffffff;
    background: rgba(41, 151, 255, 0.15);
    border: 1px solid rgba(41, 151, 255, 0.3);
  }

  .mobile-auth-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 4px 0;
  }

  @media (max-width: 820px) {
    .nav-links, .network-status, .login-link {
      display: none;
    }
    .mobile-toggle {
      display: grid;
      place-items: center;
    }
  }

  @media (max-width: 520px) {
    .navbar-wrapper {
      width: calc(100% - 20px);
      margin-top: 10px;
    }
    .nav-container {
      padding: 8px 12px;
    }
    .brand-badge {
      display: none;
    }
    .primary-btn {
      padding: 6px 10px;
      font-size: 11.5px;
    }
    .back-btn {
      padding: 6px 10px;
      font-size: 11.5px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("mobile-toggle");
  const drawer = document.getElementById("mobile-drawer");
  const openIcon = toggleBtn?.querySelector(".menu-open");
  const closeIcon = toggleBtn?.querySelector(".menu-close");

  toggleBtn?.addEventListener("click", () => {
    const isClosed = drawer?.classList.contains("hidden");
    if (isClosed) {
      drawer?.classList.remove("hidden");
      openIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      drawer?.classList.add("hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  });
</script>
