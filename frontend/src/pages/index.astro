<script>
  // Tab switcher for macOS Demo window
  const demoTabs = document.querySelectorAll(".demo-tab");
  demoTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const tabKey = (tab as HTMLElement).dataset.demoTab;
      demoTabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      document.querySelectorAll(".demo-code-block").forEach((b) => b.classList.remove("active"));
      const targetBlock = document.getElementById(`demo-code-${tabKey}`);
      if (targetBlock) targetBlock.classList.add("active");
    });
  });

  // Dynamic image resizer playground
  let curWidth = "800";
  let curFormat = "webp";
  let curQuality = "85";

  const displayCdnUrl = document.getElementById("display-cdn-url");
  const dynamicCodeUrl = document.getElementById("dynamic-code-url");
  const curlCodeUrl = document.getElementById("curl-code-url");
  const htmlCodeUrl = document.getElementById("html-code-url");
  const previewImg = document.getElementById("preview-img") as HTMLImageElement | null;
  const canvasDimBadge = document.getElementById("canvas-dim-badge");
  const canvasFormatBadge = document.getElementById("canvas-format-badge");
  const copyDemoUrlBtn = document.getElementById("btn-copy-demo-url");

  function updatePlayground() {
    const fullUrl = `https://bytebucket.hayproject.my.id/cdn/landscape.webp?w=${curWidth}&format=${curFormat}&q=${curQuality}`;

    if (displayCdnUrl) displayCdnUrl.textContent = fullUrl;
    if (dynamicCodeUrl) dynamicCodeUrl.textContent = `'${fullUrl}'`;
    if (curlCodeUrl) curlCodeUrl.textContent = `"${fullUrl}"`;
    if (htmlCodeUrl) htmlCodeUrl.textContent = `"${fullUrl}"`;

    if (previewImg) {
      previewImg.src = `https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=${curWidth}&q=${curQuality}`;
      previewImg.style.width = curWidth === "400" ? "260px" : curWidth === "800" ? "340px" : "100%";
    }

    if (canvasDimBadge) {
      const h = Math.round((parseInt(curWidth) * 533) / 800);
      canvasDimBadge.textContent = `${curWidth} × ${h} px`;
    }

    if (canvasFormatBadge) {
      canvasFormatBadge.textContent = `${curFormat.toUpperCase()} · ${curQuality}% Quality`;
    }
  }

  // Width selector buttons
  document.querySelectorAll("#width-selector .selector-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#width-selector .selector-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      curWidth = (btn as HTMLElement).dataset.width || "800";
      updatePlayground();
    });
  });

  // Format selector buttons
  document.querySelectorAll("#format-selector .selector-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#format-selector .selector-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      curFormat = (btn as HTMLElement).dataset.format || "webp";
      updatePlayground();
    });
  });

  // Quality selector buttons
  document.querySelectorAll("#quality-selector .selector-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#quality-selector .selector-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      curQuality = (btn as HTMLElement).dataset.quality || "85";
      updatePlayground();
    });
  });

  // Copy demo CDN URL
  copyDemoUrlBtn?.addEventListener("click", async () => {
    const text = displayCdnUrl?.textContent || "";
    try {
      await navigator.clipboard.writeText(text);
      const copyIcon = copyDemoUrlBtn.querySelector(".copy-icon");
      const checkIcon = copyDemoUrlBtn.querySelector(".check-icon");
      const copyText = copyDemoUrlBtn.querySelector(".copy-text");

      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyText) copyText.textContent = "Copied!";

      if (window.showToast) {
        window.showToast("Playground CDN URL copied to clipboard");
      }

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyText) copyText.textContent = "Copy";
      }, 1800);
    } catch {
      prompt("Copy URL:", text);
    }
  });
</script>
