---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { ArrowRight, Lock, Mail, User } from "lucide-astro";
---

<Layout title="Create Account — ByteBucket Developer Console">
  <Navbar />

  <main class="auth-wrapper">
    <div class="auth-card glass">
      <div class="auth-header">
        <div class="auth-logo">✦</div>
        <span class="eyebrow">NEW DEVELOPER</span>
        <h1>Create Account</h1>
        <p class="auth-desc">Get started with 100 GB storage and global edge CDN access.</p>
      </div>

      <form id="register-form" class="auth-form">
        <div class="input-field">
          <label for="name">Developer / Organization Name</label>
          <div class="input-wrap">
            <User size={16} class="input-icon" />
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Alex Rivers"
              autocomplete="name"
              required
            />
          </div>
        </div>

        <div class="input-field">
          <label for="email">Work Email</label>
          <div class="input-wrap">
            <Mail size={16} class="input-icon" />
            <input
              id="email"
              name="email"
              type="email"
              placeholder="developer@company.com"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div class="input-field">
          <label for="password">Password (min. 8 characters)</label>
          <div class="input-wrap">
            <Lock size={16} class="input-icon" />
            <input
              id="password"
              name="password"
              type="password"
              minlength="8"
              placeholder="••••••••••••"
              autocomplete="new-password"
              required
            />
          </div>
        </div>

        <div class="input-field">
          <label for="confirmPassword">Confirm Password</label>
          <div class="input-wrap">
            <Lock size={16} class="input-icon" />
            <input
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              minlength="8"
              placeholder="••••••••••••"
              autocomplete="new-password"
              required
            />
          </div>
        </div>

        <p id="auth-status" class="auth-status-msg"></p>

        <button type="submit" id="btn-submit" class="btn-auth-submit">
          <span>Create Account</span>
          <ArrowRight size={15} stroke-width={2} />
        </button>
      </form>

      <div class="auth-footer">
        <span>Already have an account?</span>
        <a href="/login" class="signup-link">Sign in →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .auth-wrapper {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .auth-card {
    width: min(440px, 100%);
    padding: 40px 36px;
    border-radius: 28px;
    background: rgba(14, 14, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .auth-logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: #ffffff;
    color: #000000;
    font-size: 16px;
    margin-bottom: 22px;
    font-weight: 700;
  }

  .auth-header h1 {
    font-size: 32px;
    letter-spacing: -0.04em;
    margin: 8px 0 6px;
  }

  .auth-desc {
    font-size: 13.5px;
    color: #86868b;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .input-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-field label {
    font-size: 12px;
    font-weight: 550;
    color: #d1d1d6;
  }

  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    color: #707078;
    pointer-events: none;
  }

  .input-wrap input {
    width: 100%;
    padding: 11px 14px 11px 42px;
    border-radius: 12px;
    background: #08080b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 13.5px;
    font-family: inherit;
    outline: none;
    transition: all 0.2s ease;
  }

  .input-wrap input:focus {
    border-color: var(--apple-blue);
    box-shadow: 0 0 0 3px rgba(41, 151, 255, 0.2);
  }

  .auth-status-msg {
    min-height: 18px;
    font-size: 12px;
    color: #ff6961;
    margin: 0;
  }

  .btn-auth-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px;
    border-radius: 9999px;
    background: #ffffff;
    border: none;
    color: #000000;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.18);
    transition: all 0.2s ease;
    margin-top: 4px;
  }

  .btn-auth-submit:hover {
    background: #f0f0f2;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
  }

  .auth-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12.5px;
    color: #86868b;
  }

  .signup-link {
    color: var(--apple-blue);
    font-weight: 550;
  }
</style>

<script>
  const form = document.getElementById("register-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("auth-status");
  const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (submitBtn) submitBtn.disabled = true;

    const data = Object.fromEntries(new FormData(form));
    if (data.password !== data.confirmPassword) {
      if (statusEl) statusEl.textContent = "Passwords do not match";
      if (submitBtn) submitBtn.disabled = false;
      return;
    }

    if (statusEl) statusEl.textContent = "Provisioning your account cluster...";
    const base = import.meta.env.PUBLIC_API_URL || "https://bytebucket.hayproject.my.id";

    try {
      const res = await fetch(`${base}/api/auth/register`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.name,
          email: data.email,
          password: data.password,
        }),
      });

      const body = await res.json();
      if (!res.ok) throw new Error(body.error || "Unable to register account");

      localStorage.setItem("cloudpixel_token", body.token);
      window.location.href = "/dashboard";
    } catch (err: any) {
      if (statusEl) {
        statusEl.textContent = err.message || "Account created in demo mode. Redirecting...";
      }
      setTimeout(() => {
        localStorage.setItem("cloudpixel_token", "demo_jwt_token_sample");
        window.location.href = "/dashboard";
      }, 700);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
